{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Stylist API",
    "version": "1.0.0",
    "description": "Public API of the AI Stylist backend. URI-versioned (`/v1`); changes within `v1` are additive.\nErrors are RFC 9457 `application/problem+json` with a stable machine `code` from\n`@ai-stylist/shared-kernel`.\n",
    "contact": {
      "name": "AI Stylist engineering"
    },
    "license": {
      "name": "Proprietary"
    }
  },
  "servers": [
    {
      "url": "https://api.ai-stylist.app",
      "description": "Production"
    },
    {
      "url": "http://localhost:3000",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "platform",
      "description": "Health, version and other non-domain endpoints"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "operationId": "getHealth",
        "tags": ["platform"],
        "summary": "Liveness and dependency health",
        "description": "Returns `ok` when the API and every checked dependency are reachable.",
        "security": [],
        "responses": {
          "200": {
            "description": "Health report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthReport"
                }
              }
            }
          },
          "503": {
            "description": "One or more dependencies are down",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    },
    "/v1/version": {
      "get": {
        "operationId": "getVersion",
        "tags": ["platform"],
        "summary": "Build identity of the running API",
        "description": "Semantic version, commit SHA and build timestamp of the deployed API.",
        "security": [],
        "responses": {
          "200": {
            "description": "Version information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          },
          "default": {
            "$ref": "#/components/responses/Problem"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ProblemDetails": {
        "type": "object",
        "description": "RFC 9457 problem details (planning/06 §2). `code` is stable and machine-readable.",
        "required": ["type", "title", "status", "code"],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "URI identifying the problem type"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599
          },
          "code": {
            "type": "string",
            "description": "Stable machine code from the shared-kernel error registry",
            "pattern": "^[A-Z][A-Z0-9_]+$"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "description": "Field-level validation failures with JSON-pointer paths",
            "items": {
              "$ref": "#/components/schemas/ProblemFieldError"
            }
          }
        }
      },
      "ProblemFieldError": {
        "type": "object",
        "required": ["pointer", "message"],
        "properties": {
          "pointer": {
            "type": "string",
            "description": "RFC 6901 JSON pointer into the request body"
          },
          "message": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "HealthCheckStatus": {
        "type": "string",
        "enum": ["ok", "down"]
      },
      "HealthReport": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "checks"],
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"]
          },
          "checks": {
            "type": "object",
            "additionalProperties": false,
            "required": ["db"],
            "properties": {
              "db": {
                "$ref": "#/components/schemas/HealthCheckStatus"
              }
            }
          }
        }
      },
      "VersionInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version", "commit", "builtAt"],
        "properties": {
          "version": {
            "type": "string",
            "description": "Semantic version of the deployed API",
            "examples": ["0.1.0"]
          },
          "commit": {
            "type": "string",
            "description": "Git commit SHA the build was produced from",
            "examples": ["0123456789abcdef0123456789abcdef01234567"]
          },
          "builtAt": {
            "type": "string",
            "format": "date-time",
            "description": "RFC 3339 UTC build timestamp"
          }
        }
      }
    },
    "responses": {
      "Problem": {
        "description": "Error (RFC 9457)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
