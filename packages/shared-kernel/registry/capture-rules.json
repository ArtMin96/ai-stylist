{
  "$schema": "./capture-rules.schema.json",
  "captureModes": ["flat", "hanger", "worn"],
  "lockReasons": ["no-item", "cut-off", "body-parts-missing", "covered", "too-small", "not-steady"],
  "bodyParts": [
    "leftShoulder",
    "rightShoulder",
    "leftHip",
    "rightHip",
    "leftKnee",
    "rightKnee",
    "leftAnkle",
    "rightAnkle"
  ],
  "hints": {
    "cap-hint-warming-up": { "kind": "blocking" },
    "cap-hint-no-item": { "kind": "blocking", "lockReason": "no-item" },
    "cap-hint-cut-off-multiple": { "kind": "blocking", "lockReason": "cut-off" },
    "cap-hint-cut-off-top": { "kind": "blocking", "lockReason": "cut-off" },
    "cap-hint-cut-off-bottom": { "kind": "blocking", "lockReason": "cut-off" },
    "cap-hint-cut-off-left": { "kind": "blocking", "lockReason": "cut-off" },
    "cap-hint-cut-off-right": { "kind": "blocking", "lockReason": "cut-off" },
    "cap-hint-body-shoulders-hips": { "kind": "blocking", "lockReason": "body-parts-missing" },
    "cap-hint-body-hips-ankles": { "kind": "blocking", "lockReason": "body-parts-missing" },
    "cap-hint-body-hips-knees": { "kind": "blocking", "lockReason": "body-parts-missing" },
    "cap-hint-body-shoulders-knees": { "kind": "blocking", "lockReason": "body-parts-missing" },
    "cap-hint-covered": { "kind": "blocking", "lockReason": "covered" },
    "cap-hint-too-small": { "kind": "blocking", "lockReason": "too-small" },
    "cap-hint-not-steady": { "kind": "blocking", "lockReason": "not-steady" },
    "cap-hint-too-dark": { "kind": "advisory" },
    "cap-hint-too-bright": { "kind": "advisory" },
    "cap-hint-tilt": { "kind": "advisory" },
    "cap-hint-guide": { "kind": "status" },
    "cap-hint-ready": { "kind": "status" },
    "cap-hint-capturing": { "kind": "status" },
    "cap-hint-next-item": { "kind": "status" }
  },
  "families": {
    "top": {
      "minAreaShare": 0.2,
      "modes": ["flat", "hanger", "worn"],
      "wornRequiredParts": ["leftShoulder", "rightShoulder", "leftHip", "rightHip"],
      "wornHint": "cap-hint-body-shoulders-hips"
    },
    "long-bottom": {
      "minAreaShare": 0.15,
      "modes": ["flat", "hanger", "worn"],
      "wornRequiredParts": ["leftHip", "rightHip", "leftAnkle", "rightAnkle"],
      "wornHint": "cap-hint-body-hips-ankles"
    },
    "short-bottom": {
      "minAreaShare": 0.12,
      "modes": ["flat", "hanger", "worn"],
      "wornRequiredParts": ["leftHip", "rightHip", "leftKnee", "rightKnee"],
      "wornHint": "cap-hint-body-hips-knees"
    },
    "one-piece": {
      "minAreaShare": 0.18,
      "modes": ["flat", "hanger", "worn"],
      "wornRequiredParts": ["leftShoulder", "rightShoulder", "leftKnee", "rightKnee"],
      "wornHint": "cap-hint-body-shoulders-knees"
    },
    "outerwear": {
      "minAreaShare": 0.2,
      "modes": ["flat", "hanger", "worn"],
      "wornRequiredParts": ["leftShoulder", "rightShoulder", "leftHip", "rightHip"],
      "wornHint": "cap-hint-body-shoulders-hips"
    },
    "shoes": { "minAreaShare": 0.06, "modes": ["flat"], "wornRequiredParts": [] },
    "bag": { "minAreaShare": 0.08, "modes": ["flat", "hanger"], "wornRequiredParts": [] },
    "small-item": { "minAreaShare": 0.015, "modes": ["flat"], "wornRequiredParts": [] },
    "generic": {
      "minAreaShare": 0.08,
      "modes": ["flat", "hanger", "worn"],
      "wornRequiredParts": []
    }
  },
  "edgeBandShare": 0.02,
  "evaluation": { "intervalMs": 100 },
  "analysisFrame": { "widthPx": 640, "heightPx": 480 },
  "steady": {
    "maxCentreShift": 0.02,
    "maxAreaChangeShare": 0.08,
    "minSharpness": 12,
    "sharpnessLongSidePx": 320,
    "laplacianKernelPx": 3
  },
  "light": {
    "tooDarkBelowMeanLuma": 45,
    "tooBrightAboveMeanLuma": 215,
    "clippedMinLuma": 250,
    "tooBrightAboveClippedShare": 0.25
  },
  "tilt": { "hintAboveDegrees": 20, "clearBelowDegrees": 15 },
  "covered": { "aboveOverlapShare": 0.5, "minOtherBoxAreaShare": 0.005 },
  "lock": {
    "unlockAfterPassingEvaluations": 3,
    "relockAfterFailingEvaluations": 3,
    "ringFillMs": 500,
    "ringMinEvaluations": 3
  },
  "batch": { "cooldownExitEvaluations": 3, "newItemBelowIou": 0.5 },
  "timing": {
    "anywayDelayMs": 10000,
    "guideHintMs": 1500,
    "hintHoldEvaluations": 2,
    "hintMinVisibleMs": 1000,
    "speechMinGapMs": 1500,
    "speechRepeatWindowMs": 5000
  },
  "worn": { "minAreaShare": 0.25, "keypointMinCoordinate": 0.02, "keypointMaxCoordinate": 0.98 },
  "mask": {
    "intervalMs": 250,
    "hotIntervalMs": 1000,
    "minInstanceAreaShare": 0.005,
    "cutOffAboveEdgeContactShare": 0.04,
    "hangerTopCutOffAboveEdgeContactShare": 0.1
  },
  "outline": {
    "cropGrowDivisor": 8,
    "cropGrowMinPx": 2,
    "longSidePx": 64,
    "foregroundAtLeast": 0.5,
    "epsilonPx": 0.5,
    "pointCount": 64,
    "keepAtLeastIou": 0.3,
    "switchAtAreaRatio": 1.5,
    "snapBelowIou": 0.5,
    "snapKeepsShapeAtLeastIou": 0.5,
    "emaAlpha": 0.5,
    "clearAfterMissedUpdates": 3,
    "iouGridCells": 64
  },
  "ios": {
    "poseIntervalMs": 250,
    "maxUserAccelerationG": 0.08,
    "maxRotationRateRadPerS": 0.5,
    "minKeypointConfidence": 0.3
  },
  "android": {
    "maxLinearAccelerationMps2": 0.8,
    "gravityLowPassAlpha": 0.8,
    "minKeypointInFrameLikelihood": 0.5
  }
}
