# dependencies / build
node_modules/
.turbo/
dist/
build/
coverage/
*.tsbuildinfo

# env & secrets (only *.enc.yaml under secrets/ is committed; `just secrets-sync` merges into .env)
.env
.env.*.local
secrets/*
!secrets/README.md
!secrets/*.enc.yaml
.direnv/
.mise.local.toml
mise.local.toml

# Native apps (apps/ios, apps/android keep their own .gitignore); signing material is never committed
*.jks
*.keystore

# python
.venv/
__pycache__/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.pyc

# logs / OS
*.log
.DS_Store
Thumbs.db

# editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# generated output, never committed: `just security-scan` / `just sbom` write artifacts/sbom/;
# `just dev` keeps its logs, pid files and stamps in artifacts/dev/
artifacts/
sbom.*.json
gitleaks-report.json

# license-gate fixture: a hand-written node_modules tree that must be committed (docs/security/licenses.md)
!tools/security/fixtures/agpl-tree/node_modules/
.pnpm-store/

# Claude Code agent worktrees and personal settings (local only)
.claude/worktrees/
.claude/settings.local.json
