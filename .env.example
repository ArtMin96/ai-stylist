# ---------------------------------------------------------------------------
# AI Stylist — configuration keys (planning/15 §6).
# Exhaustive, ZERO real values. Every key: what it is / where to get it / which envs.
# `just doctor` fails if .env lacks any key listed here. CI checks this file ⊇ config schema.
# Real dev values come from `just secrets-sync` (sops → .env). Never commit .env.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# Environment name: local | dev | staging | prod. All envs.
APP_ENV=
# pino / structlog level: trace|debug|info|warn|error. All envs.
LOG_LEVEL=
# API listen port (NestJS/Fastify). local/dev.
API_PORT=
# Public base URL of the API (used by mobile + generated client). All envs.
API_BASE_URL=
# Node runtime mode: development | test | production. Dev-only routes (POST /v1/dev/*) exist unless production.
NODE_ENV=
# Fallback listen port set by the container platform (Coolify); API_PORT wins when both are set.
PORT=
# Build identity served by GET /v1/version (set by the release step; safe defaults locally).
APP_VERSION=
GIT_COMMIT=
BUILD_TIME=
# Rate-limit skeleton (@fastify/rate-limit): max requests per window per IP. Defaults 600 / 60000 ms (doc 11 §14).
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=

# --- Database (self-managed PostgreSQL 17 + pgvector; local docker pgvector) ---
# Postgres connection string. local: docker compose; dev/staging/prod: sops per environment, host on the private Docker network.
# local: postgres://ai_stylist:ai_stylist@localhost:${POSTGRES_HOST_PORT:-5432}/ai_stylist
DATABASE_URL=
# Host port docker-compose publishes the local Postgres on (default 5432). local only.
POSTGRES_HOST_PORT=

# --- Object storage (Cloudflare R2, StorageProvider port) ---------------------
# R2 account id (Cloudflare dashboard → R2). dev/staging/prod.
R2_ACCOUNT_ID=
# R2 access key id / secret (scoped API token per env).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name per env (media uploads, presigned PUT/GET).
R2_BUCKET=
# Custom-domain base URL for public app assets (cached); user media is always presigned. Optional in local.
R2_PUBLIC_BASE_URL=

# --- Observability (OTel → Grafana Cloud; ADR-OBS-01) -------------------------
# OTLP endpoint (Grafana Cloud → OpenTelemetry). dev/staging/prod.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP headers, e.g. "Authorization=Basic <base64>". dev/staging/prod.
OTEL_EXPORTER_OTLP_HEADERS=
# Service name reported to OTel (api | workers-ml). All envs.
OTEL_SERVICE_NAME=

# --- Analytics / crash (PostHog; consent stub default OFF) --------------------
# PostHog project API key (client-side). Leave empty locally: stub sends zero events.
POSTHOG_API_KEY=
# PostHog host (e.g. https://eu.i.posthog.com).
POSTHOG_HOST=

# --- AI / ML providers (domain modules never import provider SDKs directly) ---
# fal.ai API key (try-on / segmentation). dev/staging/prod.
FAL_KEY=
# Open-Meteo needs no key; base URL override for tests/mocks (optional).
OPEN_METEO_BASE_URL=

# --- Billing (RevenueCat) -------------------------------------------------------
# RevenueCat secret API key (server-side entitlements). dev/staging/prod.
REVENUECAT_SECRET_KEY=
# RevenueCat webhook auth header value. dev/staging/prod.
REVENUECAT_WEBHOOK_SECRET=

# --- Push notifications (FCM) ---------------------------------------------------
# Firebase service-account JSON, base64-encoded. dev/staging/prod.
FCM_SERVICE_ACCOUNT_B64=

# --- Auth / identity ------------------------------------------------------------
# JWT signing secret for API sessions (rotate same-day if ever exposed). All envs.
JWT_SECRET=
# Apple Sign-In service id / team id / key id (App Store Connect). staging/prod.
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
# Google Sign-In OAuth client id (Google Cloud console). staging/prod.
GOOGLE_SIGNIN_CLIENT_ID=

# --- Mobile / Expo --------------------------------------------------------------
# Expo/EAS project id (eas.json / app.config). All envs.
EXPO_PUBLIC_EAS_PROJECT_ID=
# API base URL baked into the mobile client (EXPO_PUBLIC_* is shipped in the bundle — no secrets).
# Empty = http://localhost:3000 (apps/mobile/src/lib/config.ts); a device on the LAN needs the host's IP.
EXPO_PUBLIC_API_BASE_URL=

# --- Turborepo remote cache (optional locally, set in CI) ----------------------
TURBO_TOKEN=
TURBO_TEAM=
