          "expr": "sum by (http_route) (rate(stylist_api_request_errors_total{service_name=\"api\", deployment_environment_name=~\"$env\", error_class=\"5xx\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}",
          "instant": false,
          "range": true
