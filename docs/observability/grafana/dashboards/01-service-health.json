      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "((sum(rate(stylist_api_request_errors_total{service_name=\"api\", deployment_environment_name=~\"$env\", error_class=\"5xx\"}[1h])) or vector(0)) / sum(rate(stylist_api_request_duration_seconds_count{service_name=\"api\", deployment_environment_name=~\"$env\"}[1h]))) / 0.005",
          "legendFormat": "burn 1h",
          "instant": false,
          "range": true
