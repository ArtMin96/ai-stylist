    {
      "id": 6,
      "type": "row",
      "title": "SLO: availability 99.5 % monthly (planning/14 §12)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "panels": []
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Availability, dashboard range",
      "description": "1 - 5xx / all requests over the selected range. Target 99.5 % monthly; the free tier keeps 14 days, so ranges longer than 14 d show only what is retained (ADR-0007).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 18
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.995
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "1 - ((sum(increase(stylist_api_request_errors_total{service_name=\"api\", deployment_environment_name=~\"$env\", error_class=\"5xx\"}[$__range])) or vector(0)) / sum(increase(stylist_api_request_duration_seconds_count{service_name=\"api\", deployment_environment_name=~\"$env\"}[$__range])))",
          "legendFormat": "availability",
          "instant": true,
          "range": false
        }
      ]
    },
