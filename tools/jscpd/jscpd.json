{
  "threshold": 0.51,
  "minTokens": 50,
  "minLines": 5,
  "maxLines": 5000,
  "maxSize": "1mb",
  "mode": "mild",
  "format": ["typescript", "javascript", "python", "kotlin", "swift", "bash"],
  "gitignore": false,
  "noTips": true,
  "reporters": ["console", "json"],
  "output": "artifacts/clone-check",
  "ignore": [
    "**/node_modules/**",
    "**/.venv/**",
    "**/dist/**",
    "**/build/**",
    "**/.build/**",
    "**/.gradle/**",
    "**/.kotlin/**",
    "**/.turbo/**",
    "**/DerivedData/**",
    "**/coverage/**",
    "**/gen/**",
    "**/generated/**",
    "**/fixtures/**",
    "**/gradlew",
    "**/pnpm-lock.yaml",
    "**/package-lock.json",
    "**/uv.lock",
    "**/*.lockfile",
    "**/Package.resolved",
    "**/verification-metadata.xml",
    "../../prototype/**",
    "../../planning/**"
  ]
}
