// Dev: debug build for local development and the simulator (scheme AIStylist-Dev).
#include "Base.xcconfig"

APP_DISPLAY_NAME = AI Stylist Dev
PRODUCT_BUNDLE_IDENTIFIER = app.aistylist.mobile.dev
// HOST-ONLY (no path, no trailing slash): API paths already start with /v1.
// The simulator shares the Mac's network, so localhost reaches `just dev-api` on port 3000.
API_BASE_URL = http:/$()/localhost:3000

// MARK: Debug build
SWIFT_OPTIMIZATION_LEVEL = -Onone
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG $(inherited)
GCC_OPTIMIZATION_LEVEL = 0
GCC_PREPROCESSOR_DEFINITIONS = DEBUG=1 $(inherited)
// With a dSYM, so the forced test crash (debug tools) symbolicates in PostHog (P02 AC-6).
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES
COPY_PHASE_STRIP = NO

// MARK: Dev-only design-system catalog (AI-195)
// project.yml builds the DesignSystemCatalog product with `link: false`; Dev alone links its object,
// so Preview and Prod hold no catalog code (P0 spike, 2026-10-20: 0 symbols, 0 strings in Prod).
// The capture test harness (capture brief §11) is linked the same way: Dev only, never Preview or Prod.
OTHER_LDFLAGS = $(inherited) $(BUILT_PRODUCTS_DIR)/DesignSystemCatalog.o $(BUILT_PRODUCTS_DIR)/CaptureDebug.o
