{
  "branch": "main",
  "required_checks_workflow": ".github/workflows/pr-gate.yml",
  "repository": {
    "security_and_analysis": {
      "secret_scanning": { "status": "enabled" },
      "secret_scanning_push_protection": { "status": "enabled" }
    }
  },
  "actions_permissions": {
    "enabled": true,
    "allowed_actions": "all"
  },
  "actions_workflow_permissions": {
    "default_workflow_permissions": "read",
    "can_approve_pull_request_reviews": false
  },
  "branch_protection": {
    "required_status_checks": {
      "strict": true,
      "contexts": [
        "Gate · just ci-parity",
        "Gate · Contracts (generate --check, spectral, oasdiff)",
        "Gate · Secret scan (PR diff)",
        "Gate · Clone detection",
        "Report · PR gate summary"
      ]
    },
    "enforce_admins": true,
    "required_pull_request_reviews": {
      "required_approving_review_count": 0,
      "require_code_owner_reviews": false,
      "dismiss_stale_reviews": false
    },
    "restrictions": null,
    "allow_force_pushes": false,
    "allow_deletions": false
  },
  "labels": [
    {
      "name": "dependencies",
      "color": "0366d6",
      "description": "Dependency update (Renovate)"
    },
    {
      "name": "needs-adr",
      "color": "b60205",
      "description": "Major runtime bump: needs an ADR before merge"
    },
    {
      "name": "android",
      "color": "3ddc84",
      "description": "Touches apps/android"
    },
    {
      "name": "ios",
      "color": "1d76db",
      "description": "Touches apps/ios"
    },
    {
      "name": "needs-deps-lock",
      "color": "fbca04",
      "description": "Run just android-deps-lock on the branch before merge"
    },
    {
      "name": "security",
      "color": "d93f0b",
      "description": "Security advisory or vulnerability fix"
    }
  ]
}
