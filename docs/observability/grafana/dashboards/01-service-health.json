      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(stylist_api_request_duration_seconds_bucket{service_name=\"api\", deployment_environment_name=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "{{http_route}}",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx responses per second by route",
