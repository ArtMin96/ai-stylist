strict-peer-dependencies=false
auto-install-peers=true
# Keep the content-addressable store out of the repo. pnpm's default puts it at the root of the
# *project's* filesystem (<mount>/.pnpm-store) whenever the repo is not on the same disk as $HOME,
# which lands it inside the checkout and lets prettier/eslint/gitleaks crawl ~800 MB of blobs.
store-dir=${HOME}/.local/share/pnpm/store
