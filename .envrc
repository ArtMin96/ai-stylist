# direnv (planning/15 §6): load the gitignored .env produced by `just secrets-sync`
# (or copied from .env.example by `just bootstrap`). No shell activation of mise is
# required here — the justfile prepends mise shims to PATH itself.
dotenv_if_exists .env
# Per-machine native SDK paths (ANDROID_HOME, platform-tools on PATH), written by
# `just bootstrap --system`; outside the repo, never committed.
source_env_if_exists "$HOME/.config/ai-stylist/env.sh"
