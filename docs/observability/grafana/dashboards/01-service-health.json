{
  "id": null,
  "uid": "ai-stylist-service-health",
  "title": "01 Service health",
  "description": "Dashboard 1, planning/14 §6. Owners (role observability): ${OWNERS:observability}. Source of truth: docs/observability/grafana/dashboards/01-service-health.json; change it there and run just observability-sync. UI edits are overwritten.",
  "tags": [
    "ai-stylist",
    "service-health",
    "owner-role:observability",
    "${OWNER_TAGS:observability}"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "schemaVersion": 39,
  "links": [
    {
      "title": "Runbooks",
      "type": "link",
      "icon": "doc",
      "url": "https://github.com/ArtMin96/ai-stylist/tree/main/docs/runbooks",
      "targetBlank": true,
      "tooltip": "docs/runbooks"
    },
    {
      "title": "Observability docs",
      "type": "link",
      "icon": "info",
      "url": "https://github.com/ArtMin96/ai-stylist/tree/main/docs/observability",
      "targetBlank": true,
      "tooltip": "docs/observability"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "regex": "/-prom$/",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1
      },
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "definition": "label_values(target_info, deployment_environment_name)",
        "query": {
          "query": "label_values(target_info, deployment_environment_name)",
          "refId": "env"
        },
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [],
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "API: latency and errors",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "API latency p50 / p95 / p99",
      "description": "stylist.api.request.duration, all routes. Budgets (planning/13 §12.2, hypotheses until P14): p50 80 ms, p95 250 ms, p99 600 ms; the line marks the p95 budget.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "auto",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(stylist_api_request_duration_seconds_bucket{service_name=\"api\", deployment_environment_name=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(stylist_api_request_duration_seconds_bucket{service_name=\"api\", deployment_environment_name=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(stylist_api_request_duration_seconds_bucket{service_name=\"api\", deployment_environment_name=~\"$env\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "instant": false,
          "range": true
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API latency p95 by route",
      "description": "Per http.route; find the slow route before opening a trace.",
