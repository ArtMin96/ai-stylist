# ---------------------------------------------------------------------------
# AI Stylist — configuration keys (planning/15 §6).
# Exhaustive, ZERO real values. Every key: what it is / where to get it / which envs.
# `just doctor` fails if .env lacks any key listed here. CI checks this file ⊇ config schema.
# Real dev values come from `just secrets-sync` (sops → .env). Never commit .env.
# `just secrets-push` goes the other way: it copies the values your .env holds into
# secrets/dev.enc.yaml (a dry run unless --apply; --apply adds and fills, and overwrites a shared
# value that differs from yours only with --replace). In .env a comment goes on its own line: a
# value followed by one (KEY=value # note) is refused. It never copies a key tagged machine-local:
# a comment line that starts with the tag "[machine-local]" marks the KEY= line(s) directly below
# its comment block as a value every machine keeps for itself (`just doctor` does not report such
# a key as "only on this machine" either). Delete the tag line to make a key shareable.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# Environment name: local | dev | staging | prod. All envs. Required: the API and the jobs process refuse to boot without it (no default).
# [machine-local] every machine and every deployed environment names itself (`just bootstrap` fills an empty one with `local`; `just doctor` warns while it is empty, because telemetry then has no deployment.environment.name).
APP_ENV=
# pino / structlog level: trace|debug|info|warn|error. All envs.
# [machine-local] a preference of the machine it runs on.
LOG_LEVEL=
# API listen port (NestJS/Fastify). local/dev.
# [machine-local] depends on the ports that are free on the machine.
API_PORT=
# Public base URL of the API (used by the generated clients). All envs.
# [machine-local] follows the machine's own port or tunnel.
API_BASE_URL=
# Node runtime mode: development | test | production. Dev-only routes (POST /v1/dev/*) exist unless production.
# [machine-local] set per process and per environment.
NODE_ENV=
# Fallback listen port set by the container platform (Coolify); API_PORT wins when both are set.
# [machine-local] the platform sets it.
PORT=
# Build identity served by GET /v1/version (set by the release step; safe defaults locally).
# [machine-local] the release step sets all three.
APP_VERSION=
GIT_COMMIT=
BUILD_TIME=
# Rate-limit skeleton (@fastify/rate-limit): max requests per window per IP. Defaults 600 / 60000 ms (doc 11 §14).
RATE_LIMIT_MAX=
RATE_LIMIT_WINDOW_MS=

# --- Database (self-managed PostgreSQL 18 + pgvector; local docker pgvector) ---
# Postgres connection string. local: docker compose; dev/staging/prod: sops per environment, host on the private Docker network.
# local: postgres://ai_stylist:ai_stylist@localhost:${POSTGRES_HOST_PORT:-5432}/ai_stylist
# [machine-local] .env keeps the local docker value (`just bootstrap` fills it); a staging string is only ever there temporarily.
DATABASE_URL=
# Host port docker-compose publishes the local Postgres on (default 5432). local only.
# [machine-local]
POSTGRES_HOST_PORT=

# --- Object storage (Cloudflare R2, StorageProvider port) ---------------------
# R2 account id (Cloudflare dashboard → R2). dev/staging/prod.
R2_ACCOUNT_ID=
# R2 access key id / secret (scoped API token per env).
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket name per env (media uploads, presigned PUT/GET).
R2_BUCKET=
# Custom-domain base URL for public app assets (cached); user media is always presigned. Optional in local.
R2_PUBLIC_BASE_URL=
# Opt-in for the live R2 test suite (apps/api/src/platform/tests/r2-storage.live.sec.test.ts): 1 runs it against the bucket R2_BUCKET names (with the four R2_* keys above); empty skips it. local/dev only; never set in CI, staging or prod.
# [machine-local] a developer's own per-run choice, never shared through secrets/dev.enc.yaml.
R2_LIVE_TEST=

# --- Observability (OTel → Grafana Cloud; ADR-OBS-01) -------------------------
# OTLP endpoint (Grafana Cloud → OpenTelemetry). dev/staging/prod.
OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP headers, e.g. "Authorization=Basic <base64>". dev/staging/prod.
OTEL_EXPORTER_OTLP_HEADERS=
# Service name reported to OTel (api | jobs | segmentation); leave empty locally — one .env serves every process, each has its own default
# [machine-local] stays empty in the shared file as well (docs/SERVICES-SETUP.md §11 step 4).
OTEL_SERVICE_NAME=
# Grafana Cloud stack URL, https://<stack>.grafana.net, for `just observability-sync`. dev (one stack serves every env).
GRAFANA_URL=
# Grafana service-account token (glsa_…, Admin role) for `just observability-sync`. dev only; never a CI secret.
GRAFANA_SERVICE_ACCOUNT_TOKEN=
# Comma list of on-call alert addresses (personal data), written into the ai-stylist-oncall contact point by `just observability-sync`. dev.
GRAFANA_ALERT_EMAILS=
# IANA time zone that alert quiet hours (23:00–08:00) follow, e.g. Europe/Berlin, for `just observability-sync`. dev.
GRAFANA_ONCALL_TIMEZONE=

# --- Analytics / crash (PostHog; consent stub default OFF) --------------------
# PostHog project key phc_… (apps: compiled in; API: server-side flag evaluation). A personal phx_ key is refused. Empty: apps send nothing, API flags use registry defaults.
POSTHOG_API_KEY=
# PostHog ingestion host; this project is on US Cloud: https://us.i.posthog.com (EU Cloud: https://eu.i.posthog.com). The API requires it when POSTHOG_API_KEY is set.
POSTHOG_HOST=
# Personal API key (phx_…) with only error tracking write + organization read: build-time dSYM/R8 mapping upload only. dev; CI: GitHub secret (iOS/Android workflows).
POSTHOG_CLI_API_KEY=
# Numeric PostHog project id, for the symbol upload and `just observability-sync`. dev; CI: GitHub variable.
POSTHOG_CLI_PROJECT_ID=
# PostHog app/API host (not the ingestion host); this project is on US Cloud: https://us.posthog.com (EU Cloud: https://eu.posthog.com), for the symbol upload and `just observability-sync`. dev; CI: GitHub variable.
POSTHOG_CLI_HOST=
# Personal API key (phx_…) for `just observability-sync`: project, feature_flag, hog_function read/write; its owner is a project admin. dev only; never a CI secret.
POSTHOG_SYNC_API_KEY=

# --- AI / ML providers (domain modules never import provider SDKs directly) ---
# fal.ai API key (try-on / segmentation). dev/staging/prod.
FAL_KEY=
# Open-Meteo needs no key; base URL override for tests/mocks (optional).
OPEN_METEO_BASE_URL=

# --- Billing (RevenueCat) -------------------------------------------------------
# RevenueCat secret API key (server-side entitlements). dev/staging/prod.
REVENUECAT_SECRET_KEY=
# RevenueCat webhook auth header value. dev/staging/prod.
REVENUECAT_WEBHOOK_SECRET=

# --- Push notifications (FCM) ---------------------------------------------------
# Firebase service-account JSON, base64-encoded. dev/staging/prod.
FCM_SERVICE_ACCOUNT_B64=

# --- Auth / identity ------------------------------------------------------------
# JWT signing secret for API sessions (rotate same-day if ever exposed). All envs.
JWT_SECRET=
# Apple Sign-In service id / team id / key id (App Store Connect). staging/prod.
APPLE_SIGNIN_CLIENT_ID=
APPLE_SIGNIN_TEAM_ID=
APPLE_SIGNIN_KEY_ID=
# Google Sign-In OAuth client id (Google Cloud console). staging/prod.
GOOGLE_SIGNIN_CLIENT_ID=

# --- Native apps ----------------------------------------------------------------
# The iOS and Android apps do not read this file. They take API_BASE_URL (host only, no path)
# from their own per-environment build config; see apps/ios and apps/android.

# --- Turborepo remote cache (optional locally, set in CI) ----------------------
TURBO_TOKEN=
TURBO_TEAM=
