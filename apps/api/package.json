{
  "name": "@ai-stylist/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS (Fastify adapter) modular monolith: composition root, platform adapters, one directory per SPINE domain module (planning/04 \u00a74\u2013\u00a75).",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/platform/telemetry/instrument-api.ts src/main.ts",
    "dev:jobs": "tsx watch --env-file-if-exists=../../.env --import ./src/platform/telemetry/instrument-jobs.ts src/jobs/main.ts",
    "jobs": "tsx --env-file-if-exists=../../.env --import ./src/platform/telemetry/instrument-jobs.ts src/jobs/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env --import ./dist/apps/api/src/platform/telemetry/instrument-api.js dist/apps/api/src/main.js",
    "start:jobs": "node --env-file-if-exists=../../.env --import ./dist/apps/api/src/platform/telemetry/instrument-jobs.js dist/apps/api/src/jobs/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-stylist/contracts": "workspace:*",
    "@ai-stylist/db": "workspace:*",
    "@ai-stylist/shared-kernel": "workspace:*",
    "@fastify/otel": "^0.21.0",
    "@fastify/rate-limit": "^11.2.0",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-pino": "^0.68.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fastify": "5.12.5",
    "nestjs-pino": "^5.2.1",
    "pg-boss": "^12.34.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "postgres": "^3.4.9",
    "posthog-node": "^5.54.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-stylist/seed-data": "workspace:*",
    "@ai-stylist/test-support": "workspace:*",
    "@nestjs/testing": "^12.1.0",
    "@swc/core": "^1.16.2",
    "@types/node": "^24.13.6",
    "drizzle-orm": "^0.45.3",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.2"
  }
}
