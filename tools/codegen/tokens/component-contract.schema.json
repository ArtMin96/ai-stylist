{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Component contract",
  "description": "One .impeccable/components/<id>.yaml file (ADR-0011 follow-up 7, DEC-87). Field rules: .impeccable/components/README.md. Checked by tools/codegen/tokens/contracts.mjs (rule CC-01); the cross-field rules CC-02 to CC-18 are in tools/codegen/tokens/README.md. Without `kind` it is a control contract (button, chip); `kind: icon-set` is an icon set (C02).",
  "type": "object",
  "if": { "type": "object", "properties": { "kind": true }, "required": ["kind"] },
  "then": { "$ref": "#/$defs/iconSet" },
  "else": { "$ref": "#/$defs/control" },
  "$defs": {
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "board",
        "name",
        "props",
        "variants",
        "sizes",
        "states",
        "combinations",
        "tokens",
        "accessibility",
        "gallery",
        "testId",
        "approved"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "board": { "$ref": "#/$defs/board" },
        "name": { "$ref": "#/$defs/typeName" },
        "props": { "type": "array", "items": { "$ref": "#/$defs/prop" } },
        "variants": { "$ref": "#/$defs/idList" },
        "sizes": { "$ref": "#/$defs/idList" },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/kebab" },
          "contains": { "type": "string", "const": "enabled" }
        },
        "combinations": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/kebab" },
          "additionalProperties": { "$ref": "#/$defs/combination" }
        },
        "tokens": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/kebab" },
          "additionalProperties": { "$ref": "#/$defs/variantTokens" }
        },
        "icons": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/kebab" },
          "additionalProperties": { "$ref": "#/$defs/variantIcons" }
        },
        "parts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/part" } },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role", "label"],
          "properties": {
            "role": { "$ref": "#/$defs/role" },
            "roles": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/kebab" },
              "additionalProperties": { "$ref": "#/$defs/role" }
            },
            "selection": { "$ref": "#/$defs/propReference" },
            "label": { "$ref": "#/$defs/propReference" },
            "labelOverride": { "$ref": "#/$defs/propReference" },
            "busy": { "$ref": "#/$defs/kebab" },
            "minTouchTarget": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ios", "android"],
              "properties": {
                "ios": { "type": "number", "exclusiveMinimum": 0 },
                "android": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        },
        "gallery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "label", "include"],
          "properties": {
            "title": { "$ref": "#/$defs/galleryTitle" },
            "label": { "type": "string", "minLength": 1 },
            "props": {
              "type": "object",
              "minProperties": 1,
              "propertyNames": { "$ref": "#/$defs/propName" },
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            "include": {
              "oneOf": [
                { "type": "string", "const": "all" },
                { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/galleryItem" } }
              ]
            }
          }
        },
        "testId": { "type": "string", "const": "ds-{component}-{variant}-{size}-{state}" },
        "approved": { "$ref": "#/$defs/approved" }
      }
    },
    "iconSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "board",
        "name",
        "kind",
        "accessibility",
        "gallery",
        "sizes",
        "defaultSize",
        "glyphs",
        "approved"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "board": { "$ref": "#/$defs/board" },
        "name": { "$ref": "#/$defs/typeName" },
        "kind": { "type": "string", "const": "icon-set" },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["role"],
          "properties": { "role": { "type": "string", "const": "decorative" } }
        },
        "gallery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title"],
          "properties": { "title": { "$ref": "#/$defs/galleryTitle" } }
        },
        "sizes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/iconSize" }
        },
        "defaultSize": { "$ref": "#/$defs/iconSize" },
        "glyphs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/glyph" } },
        "approved": { "$ref": "#/$defs/approved" }
      }
    },
    "kebab": { "type": "string", "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$" },
    "board": { "type": "string", "pattern": "^C(0[1-9]|10)$" },
    "typeName": {
      "type": "string",
      "pattern": "^App[A-Z][A-Za-z]+$",
      "not": { "type": "string", "pattern": "[Gg][Aa][Rr][Dd][Ee][Rr][Ii]" }
    },
    "galleryTitle": { "type": "string", "pattern": "^[A-Za-z0-9]+( [A-Za-z0-9]+)*$" },
    "approved": {
      "oneOf": [
        { "type": "string", "const": "pending" },
        { "type": "string", "format": "date" }
      ]
    },
    "idList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/kebab" }
    },
    "propName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
    "propReference": { "type": "string", "pattern": "^\\{props\\.[a-z][A-Za-z0-9]*\\}$" },
    "propType": {
      "type": "string",
      "enum": ["string", "bool", "icon", "action", "enum", "color", "colorRole"]
    },
    "role": {
      "type": "string",
      "enum": [
        "button",
        "toggle",
        "radio",
        "selectable",
        "disclosure",
        "menu",
        "text",
        "region",
        "decorative"
      ]
    },
    "prop": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "required"],
          "properties": {
            "name": { "$ref": "#/$defs/propName" },
            "type": { "$ref": "#/$defs/propType" },
            "values": { "$ref": "#/$defs/idList" },
            "variants": { "$ref": "#/$defs/idList" },
            "required": { "type": "boolean", "const": true }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "type", "default"],
          "properties": {
            "name": { "$ref": "#/$defs/propName" },
            "type": { "$ref": "#/$defs/propType" },
            "values": { "$ref": "#/$defs/idList" },
            "variants": { "$ref": "#/$defs/idList" },
            "default": {}
          }
        }
      ]
    },
    "part": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "position"],
      "properties": {
        "name": { "$ref": "#/$defs/propName" },
        "kind": { "type": "string", "enum": ["text", "swatch", "dot", "ring"] },
        "position": {
          "type": "string",
          "enum": ["before-label", "after-label", "line", "outside"]
        },
        "separator": { "type": "string", "minLength": 1 },
        "color": { "$ref": "#/$defs/propReference" },
        "icon": { "type": "string", "const": "leading" },
        "variants": { "$ref": "#/$defs/idList" }
      }
    },
    "combination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sizes", "states"],
      "properties": {
        "sizes": { "$ref": "#/$defs/idList" },
        "states": { "$ref": "#/$defs/idList" }
      }
    },
    "reference": {
      "type": "string",
      "pattern": "^\\{components\\.[a-z][a-z0-9]*(-[a-z0-9]+)*\\}$"
    },
    "referenceMap": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/kebab" },
      "additionalProperties": { "$ref": "#/$defs/reference" }
    },
    "variantTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "states", "sizes"],
      "properties": {
        "base": { "$ref": "#/$defs/reference" },
        "states": { "$ref": "#/$defs/referenceMap" },
        "sizes": { "$ref": "#/$defs/referenceMap" }
      }
    },
    "iconSource": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/kebab" },
        { "type": "string", "pattern": "^\\{props\\.[a-z][A-Za-z0-9]*\\}$" }
      ]
    },
    "slotIcons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leading": { "$ref": "#/$defs/iconSource" },
        "trailing": { "$ref": "#/$defs/iconSource" }
      }
    },
    "variantIcons": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "leading": { "$ref": "#/$defs/iconSource" },
        "trailing": { "$ref": "#/$defs/iconSource" },
        "states": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/kebab" },
          "additionalProperties": { "$ref": "#/$defs/slotIcons" }
        }
      }
    },
    "galleryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["variant", "size", "state"],
      "properties": {
        "variant": { "$ref": "#/$defs/kebab" },
        "size": { "$ref": "#/$defs/kebab" },
        "state": { "$ref": "#/$defs/kebab" }
      }
    },
    "iconSize": { "type": "string", "pattern": "^icon-[a-z][a-z0-9]*$" },
    "iconSetName": {
      "type": "string",
      "enum": ["navigation", "actions", "weather", "closet", "status", "account", "capture"]
    },
    "iconPaint": { "type": "string", "enum": ["stroke", "fill", "both"] },
    "glyph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "set", "source", "shapes"],
      "properties": {
        "id": { "$ref": "#/$defs/kebab" },
        "set": { "$ref": "#/$defs/iconSetName" },
        "source": { "type": "string", "pattern": "^[A-Z]{1,3}[0-9]{1,2}$" },
        "shapes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/shape" } }
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["d", "paint"],
      "properties": {
        "d": { "type": "string", "minLength": 1 },
        "paint": { "$ref": "#/$defs/iconPaint" }
      }
    }
  }
}
