# apps/ios: generated and local build state. The Xcode project is GENERATED from project.yml
# by `just ios-project` (XcodeGen) and is never committed.
*.xcodeproj/
*.xcworkspace/
xcuserdata/
DerivedData/
.build/
.swiftpm/
build/
*.xcresult
*.ipa
*.dSYM.zip
*.dSYM/
# Per-machine build settings (POSTHOG_API_KEY / POSTHOG_HOST; see Config/Base.xcconfig).
Config/Local.xcconfig
# Signing material never lives in the repo.
*.p12
*.mobileprovision
*.cer
