{
  "name": "@ai-stylist/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "React Native + Expo (prebuild/dev-client, New Architecture) client. Imports only @ai-stylist/contracts and @ai-stylist/shared-kernel from the workspace (planning/05 §2, 04 §4.3).",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo start --dev-client --android",
    "ios": "expo start --dev-client --ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "jest --ci",
    "doctor": "expo-doctor",
    "export": "expo export --platform android --output-dir .expo/export"
  },
  "dependencies": {
    "@ai-stylist/contracts": "workspace:*",
    "@ai-stylist/shared-kernel": "workspace:*",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.17",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-expo": "^1.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "msw": "^2.15.0",
    "typescript": "~6.0.3"
  }
}
